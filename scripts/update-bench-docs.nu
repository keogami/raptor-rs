#!/usr/bin/env nu

print "Running benchmarks..."
cargo bench -p vulture --features internal --bench raptor

let csvs = glob "target/**/new/raw.csv"

if ($csvs | is-empty) {
    error make { msg: "No criterion CSV files found. Did benchmarks run?" }
}

let table = $csvs
    | each { open $in }
    | flatten
    | insert per_iter { |r| $r.sample_measured_value / $r.iteration_count }
    | group-by { |r|
        [$r.group $r.function $r.value]
        | where { $in != null and $in != "" }
        | str join "/"
    }
    | items { |name, rows|
        let times = $rows | get per_iter
        let median = $times | math median
        let stddev = $times | math stddev
        {
            Benchmark: $"`($name)`"
            Median: ($median | into duration --unit ns | format duration µs)
            "Std Dev": ($stddev | into duration --unit ns | format duration µs)
        }
    }
    | sort-by Benchmark

let header = "# Benchmark Results

> Auto-generated by `scripts/update-bench-docs.nu`
"

$header + ($table | to md) + "\n" | save -f BENCHMARKS.md

print $"Results written to BENCHMARKS.md \(($table | length) benchmarks\)"
